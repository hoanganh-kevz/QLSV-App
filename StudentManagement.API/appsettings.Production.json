{
  "ConnectionStrings": {
    "DefaultConnection": "Server=db;Database=StudentManagement;User Id=sa;Password=${DB_PASSWORD};TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "StudentManagement",
    "Audience": "StudentManagementClient",
    "ExpirationInHours": 8
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "CorsOrigins": [
    "https://yourdomain.com"
  ]
}
